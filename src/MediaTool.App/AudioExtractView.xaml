<UserControl x:Class="MediaTool.App.AudioExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="42,34,42,42" MaxWidth="920">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Audio Extract" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Save the audio track from a video or audio file as an MP3." Opacity="0.72" FontSize="14" Margin="0,6,0,24" /></StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" AllowDrop="True" DragOver="InputDropZone_DragOver" Drop="InputDropZone_Drop">
            <StackPanel>
                <StackPanel Orientation="Horizontal"><Button Content="Choose media" Padding="16,8" Click="ChooseFiles_Click" /><TextBlock Text="or drop files here to start" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" /></StackPanel>
                <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.7" /><Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveInput_Click" Padding="10,4" Margin="12,0,0,0" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,18,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="MP3 bitrate" Opacity="0.7" /><ComboBox x:Name="BitRateComboBox" SelectedIndex="1" Margin="0,6,0,0"><ComboBoxItem Content="128 kbps" /><ComboBoxItem Content="192 kbps" /><ComboBoxItem Content="256 kbps" /><ComboBoxItem Content="320 kbps" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Audio tracks" Opacity="0.7" /><ComboBox x:Name="TrackModeComboBox" SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem Content="Default track" /><ComboBoxItem Content="All tracks" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Output folder" Opacity="0.7" /><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseOutput_Click" Padding="12,4" Margin="8,0,0,0" /><TextBox x:Name="OutputFolderTextBox" ToolTip="Leave blank to save beside each source file." /></DockPanel></StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="ExtractButton" Content="Extract MP3s" Padding="18,9" Click="Extract_Click" /><Button x:Name="CancelButton" Content="Cancel active job" Padding="14,9" Margin="10,0,0,0" Click="Cancel_Click" IsEnabled="False" /><TextBlock x:Name="MessageTextBlock" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.75" /></StackPanel>
        <StackPanel Grid.Row="4" Margin="0,26,0,0"><TextBlock Text="Jobs" FontSize="18" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Jobs}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" /><TextBlock Text="{Binding Detail}" Opacity="0.68" FontSize="12" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Progress}" VerticalAlignment="Center" /><StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="Open" Tag="{Binding ResultPath}" Click="OpenResult_Click" Padding="8,3" Margin="3,0" /><Button Content="Folder" Tag="{Binding ResultPath}" Click="ShowResultFolder_Click" Padding="8,3" Margin="3,0" /><Button Content="Copy path" Tag="{Binding ResultPath}" Click="CopyResultPath_Click" Padding="8,3" Margin="3,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    </Grid>
</UserControl>
