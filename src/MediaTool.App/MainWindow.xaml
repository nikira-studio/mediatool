<Window x:Class="MediaTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaTool" Icon="Assets/MediaTool.ico"
        Width="1120" Height="720" MinWidth="820" MinHeight="560"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource NavigationBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,0">
                    <StackPanel Margin="20,0,20,20">
                        <TextBlock Text="MediaTool" Foreground="{StaticResource NavigationTextBrush}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Local media utilities" Foreground="#AEB8C8" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="CompressNavigationButton_Click" AutomationProperties.Name="Video Compress"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Video Compress" /><Ellipse x:Name="CompressActivityDot" Grid.Column="1" Width="7" Height="7" Fill="#60A5FA" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" /></Grid></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="ExtractNavigationButton_Click" AutomationProperties.Name="Audio Extract"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Audio Extract" /><Ellipse x:Name="ExtractActivityDot" Grid.Column="1" Width="7" Height="7" Fill="#60A5FA" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" /></Grid></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="TranscribeNavigationButton_Click" AutomationProperties.Name="Transcribe"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Transcribe" /><Ellipse x:Name="TranscribeActivityDot" Grid.Column="1" Width="7" Height="7" Fill="#60A5FA" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" /></Grid></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Button Content="Settings" Style="{StaticResource NavigationButtonStyle}" Click="SettingsNavigationButton_Click" AutomationProperties.Name="Settings" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="WorkPanel" Focusable="False" />
            </ScrollViewer>
            <Border x:Name="ActivityIndicator" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,34,0" Padding="12,8" CornerRadius="7" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="42" Height="4" IsIndeterminate="True" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0"><TextBlock x:Name="ActivityToolTextBlock" Text="Working" FontWeight="SemiBold" FontSize="12" /><TextBlock x:Name="ActivityPhaseTextBlock" Text="Starting" Opacity="0.68" FontSize="11" /></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
