<UserControl x:Class="MediaTool.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="42,34,42,42" MaxWidth="860">
        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Choose the defaults used when you open each tool. Changes in a tool stay with that job unless you save them here." Opacity="0.72" TextWrapping="Wrap" Margin="0,6,0,22" />

        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22"><StackPanel>
            <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" /><ComboBox x:Name="ThemeComboBox" Margin="0,10,0,0" Width="180" HorizontalAlignment="Left" SelectionChanged="ThemeComboBox_SelectionChanged"><ComboBoxItem Content="Follow system" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /></ComboBox>
        </StackPanel></Border>

        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Video Compress defaults" FontSize="18" FontWeight="SemiBold" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="160" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Maximum size" Opacity="0.7" /><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBox x:Name="VideoSizeTextBox" Width="70" /><TextBlock Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Video codec" Opacity="0.7" /><ComboBox x:Name="VideoCodecComboBox" Margin="0,6,0,0"><ComboBoxItem Content="H.264" /><ComboBoxItem Content="H.265" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Maximum resolution" Opacity="0.7" /><ComboBox x:Name="VideoResolutionComboBox" Margin="0,6,0,0"><ComboBoxItem Content="Auto" /><ComboBoxItem Content="1080p" /><ComboBoxItem Content="720p" /><ComboBoxItem Content="480p" /><ComboBoxItem Content="360p" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="Audio tracks" Opacity="0.7" /><ComboBox x:Name="VideoAudioComboBox" Margin="0,6,0,0"><ComboBoxItem Content="Default track" /><ComboBoxItem Content="All tracks" /><ComboBoxItem Content="No audio" /></ComboBox></StackPanel>
            </Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Default output folder" Opacity="0.7" /><DockPanel Margin="0,6,12,0"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseVideoOutput_Click" Padding="12,4" Margin="8,0,0,0" /><TextBox x:Name="VideoOutputTextBox" ToolTip="Leave blank to save beside each source file." /></DockPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="When finished" Opacity="0.7" /><ComboBox x:Name="VideoCompletionComboBox" Margin="0,6,0,0"><ComboBoxItem Content="Stay in app" /><ComboBoxItem Content="Open result" /><ComboBoxItem Content="Show in folder" /></ComboBox></StackPanel></Grid>
        </StackPanel></Border>

        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Audio Extract defaults" FontSize="18" FontWeight="SemiBold" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="MP3 bitrate" Opacity="0.7" /><ComboBox x:Name="AudioBitrateComboBox" Margin="0,6,0,0"><ComboBoxItem Content="128 kbps" /><ComboBoxItem Content="192 kbps" /><ComboBoxItem Content="256 kbps" /><ComboBoxItem Content="320 kbps" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Audio tracks" Opacity="0.7" /><ComboBox x:Name="AudioTrackComboBox" Margin="0,6,0,0"><ComboBoxItem Content="Default track" /><ComboBoxItem Content="All tracks" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Default output folder" Opacity="0.7" /><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseAudioOutput_Click" Padding="12,4" Margin="8,0,0,0" /><TextBox x:Name="AudioOutputTextBox" ToolTip="Leave blank to save beside each source file." /></DockPanel></StackPanel>
            </Grid>
            <StackPanel Margin="0,14,0,0" Width="220" HorizontalAlignment="Left"><TextBlock Text="When finished" Opacity="0.7" /><ComboBox x:Name="AudioCompletionComboBox" Margin="0,6,0,0"><ComboBoxItem Content="Stay in app" /><ComboBoxItem Content="Open result" /><ComboBoxItem Content="Show in folder" /></ComboBox></StackPanel>
        </StackPanel></Border>

        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Transcribe defaults" FontSize="18" FontWeight="SemiBold" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Model" Opacity="0.7" /><ComboBox x:Name="TranscriptModelComboBox" DisplayMemberPath="DisplayName" Margin="0,6,0,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Language" Opacity="0.7" /><ComboBox x:Name="TranscriptLanguageComboBox" Margin="0,6,0,0"><ComboBoxItem Content="Automatic" Tag="auto" /><ComboBoxItem Content="English" Tag="en" /><ComboBoxItem Content="Spanish" Tag="es" /><ComboBoxItem Content="French" Tag="fr" /><ComboBoxItem Content="German" Tag="de" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Default formats" Opacity="0.7" /><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><CheckBox x:Name="TranscriptTextCheckBox" Content="Text" Margin="0,0,16,0" /><CheckBox x:Name="TranscriptSrtCheckBox" Content="SubRip" Margin="0,0,16,0" /><CheckBox x:Name="TranscriptVttCheckBox" Content="WebVTT" /></StackPanel><CheckBox x:Name="TranscriptTimestampsCheckBox" Content="Include timestamps in text" Margin="0,10,0,0" /></StackPanel>
            </Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Default output folder" Opacity="0.7" /><DockPanel Margin="0,6,12,0"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseTranscriptOutput_Click" Padding="12,4" Margin="8,0,0,0" /><TextBox x:Name="TranscriptOutputTextBox" ToolTip="Leave blank to save beside each source file." /></DockPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="When finished" Opacity="0.7" /><ComboBox x:Name="TranscriptCompletionComboBox" Margin="0,6,0,0"><ComboBoxItem Content="Stay in app" /><ComboBoxItem Content="Open result" /><ComboBoxItem Content="Show in folder" /></ComboBox></StackPanel></Grid>
        </StackPanel></Border>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Save defaults" Padding="18,9" Click="Save_Click" /><Button Content="Reset defaults" Padding="18,9" Margin="10,0,0,0" Click="Reset_Click" /><TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.75" /></StackPanel>
        <TextBlock Text="Local data" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,8" /><TextBlock x:Name="DataPathTextBlock" TextWrapping="Wrap" Opacity="0.68" /><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Open data folder" Padding="16,8" Click="OpenDataFolder_Click" /><Button Content="Clear job history" Padding="16,8" Margin="8,0,0,0" Click="ClearHistory_Click" /></StackPanel>
    </StackPanel>
</UserControl>
