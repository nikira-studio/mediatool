<UserControl x:Class="MediaTool.App.TranscribeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="42,34,42,42" MaxWidth="920"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Transcribe" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Create local transcripts. Transcripts can contain errors." Opacity="0.72" FontSize="14" Margin="0,6,0,24" /></StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22"><StackPanel><TextBlock Text="Local speech model" FontSize="18" FontWeight="SemiBold" /><ComboBox x:Name="ModelComboBox" Margin="0,10,0,0" SelectionChanged="ModelSelectionChanged"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding DownloadSize.Megabytes, StringFormat={}{0:0} MB download}" FontSize="12" Opacity="0.68" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock x:Name="ModelStatusTextBlock" Text="Not installed. Model downloads are the only network activity in MediaTool." Opacity="0.72" Margin="0,10,0,8" TextWrapping="Wrap" /><ProgressBar x:Name="ModelDownloadProgressBar" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,12" /><StackPanel Orientation="Horizontal"><Button x:Name="DownloadModelButton" Content="Download selected model" Padding="14,7" Click="DownloadModel_Click" /><Button x:Name="ImportModelButton" Content="Import model file" Padding="14,7" Margin="8,0,0,0" Click="ImportModel_Click" /></StackPanel></StackPanel></Border>
        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,18,0,0" AllowDrop="True" DragOver="InputDropZone_DragOver" Drop="InputDropZone_Drop"><StackPanel><StackPanel Orientation="Horizontal"><Button Content="Choose audio or video" Padding="16,8" Click="ChooseInput_Click" /><TextBlock x:Name="InputTextBlock" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.72" /><TextBlock Text="  or drop a file here to start" VerticalAlignment="Center" Opacity="0.62" /></StackPanel><TextBlock Text="What do you need?" FontWeight="SemiBold" Margin="0,18,0,8" /><StackPanel Orientation="Horizontal"><Button Content="Meeting notes" Click="MeetingNotesPreset_Click" Padding="12,6" /><Button Content="Video captions" Click="CaptionsPreset_Click" Padding="12,6" Margin="8,0,0,0" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><TextBlock Text="Language" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox x:Name="LanguageComboBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="Automatic" Tag="auto" /><ComboBoxItem Content="English" Tag="en" /><ComboBoxItem Content="Spanish" Tag="es" /><ComboBoxItem Content="French" Tag="fr" /><ComboBoxItem Content="German" Tag="de" /></ComboBox><CheckBox x:Name="IncludeTimestampsCheckBox" Content="Include timestamps in text" IsChecked="True" Margin="24,0,0,0" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="Files" VerticalAlignment="Center" Margin="0,0,14,0" /><CheckBox x:Name="TextCheckBox" Content="Readable text (.txt)" IsChecked="True" Margin="0,0,18,0" /><CheckBox x:Name="SrtCheckBox" Content="Captions (.srt)" Margin="0,0,18,0" /><CheckBox x:Name="VttCheckBox" Content="Web captions (.vtt)" /></StackPanel><TextBlock Text="Speaker labels require an enhanced diarization engine and are not available in this local version yet." Opacity="0.62" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" /><StackPanel Margin="0,18,0,0"><TextBlock Text="Output folder" Opacity="0.7" /><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseOutput_Click" Padding="12,4" Margin="8,0,0,0" /><TextBox x:Name="OutputFolderTextBox" ToolTip="Leave blank to save beside the source file." /></DockPanel></StackPanel></StackPanel></Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="TranscribeButton" Content="Transcribe locally" Padding="18,9" Click="Transcribe_Click" /><Button x:Name="CancelButton" Content="Cancel active job" Padding="14,9" Margin="10,0,0,0" IsEnabled="False" Click="Cancel_Click" /><TextBlock x:Name="MessageTextBlock" Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.75" /></StackPanel>
        <StackPanel Grid.Row="4" Margin="0,26,0,0"><TextBlock Text="Jobs" FontSize="18" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Jobs}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" /><TextBlock Text="{Binding Detail}" Opacity="0.68" FontSize="12" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" /><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Open" Tag="{Binding ResultPath}" Click="OpenResult_Click" Padding="8,3" Margin="3,0" /><Button Content="Folder" Tag="{Binding ResultPath}" Click="ShowResultFolder_Click" Padding="8,3" Margin="3,0" /><Button Content="Copy path" Tag="{Binding ResultPath}" Click="CopyResultPath_Click" Padding="8,3" Margin="3,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Border x:Name="TranscriptResultPanel" Grid.Row="5" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,18,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="Transcript preview" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="TranscriptFilesTextBlock" Margin="0,5,0,12" Opacity="0.68" TextWrapping="Wrap" /><TextBox x:Name="TranscriptPreviewTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxHeight="300" /></StackPanel></Border>
    </Grid>
</UserControl>
