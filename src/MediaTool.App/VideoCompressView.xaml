<UserControl x:Class="MediaTool.App.VideoCompressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded">
    <Grid Margin="42,34,42,42" MaxWidth="920">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Video Compress" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Create an MP4 that stays under your chosen size." Opacity="0.72" FontSize="14" Margin="0,6,0,24" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" AllowDrop="True" DragOver="InputDropZone_DragOver" Drop="InputDropZone_Drop">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose videos" Padding="16,8" Click="ChooseFiles_Click" />
                    <TextBlock Text="or drop videos here to start" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveInput_Click" Padding="10,4" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Maximum size" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox x:Name="MaximumSizeTextBox" Text="20" Width="68" />
                        <TextBlock Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="10" Tag="10" Click="SizePreset_Click" Padding="8,3" Margin="0,0,4,0" />
                        <Button Content="20" Tag="20" Click="SizePreset_Click" Padding="8,3" Margin="0,0,4,0" />
                        <Button Content="50" Tag="50" Click="SizePreset_Click" Padding="8,3" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Video codec" Opacity="0.7" />
                    <ComboBox x:Name="CodecComboBox" SelectedIndex="0" Margin="0,6,0,0">
                        <ComboBoxItem Content="H.264" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Maximum resolution" Opacity="0.7" />
                    <ComboBox x:Name="ResolutionComboBox" SelectedIndex="0" Margin="0,6,0,0">
                        <ComboBoxItem Content="Auto" />
                        <ComboBoxItem Content="1080p" />
                        <ComboBoxItem Content="720p" />
                        <ComboBoxItem Content="480p" />
                        <ComboBoxItem Content="360p" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Audio tracks" Opacity="0.7" />
                    <ComboBox x:Name="AudioComboBox" SelectedIndex="0" Margin="0,6,0,0">
                        <ComboBoxItem Content="Default track" />
                        <ComboBoxItem Content="All tracks" />
                        <ComboBoxItem Content="No audio" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,20,0,0">
                    <TextBlock Text="Output folder" Opacity="0.7" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseOutput_Click" Padding="12,4" Margin="8,0,0,0" />
                        <TextBox x:Name="OutputFolderTextBox" ToolTip="Leave blank to save beside each source file." />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="CompressButton" Content="Compress videos" Padding="18,9" Click="Compress_Click" />
            <Button x:Name="CancelButton" Content="Cancel active job" Padding="14,9" Margin="10,0,0,0" Click="Cancel_Click" IsEnabled="False" />
            <TextBlock x:Name="MessageTextBlock" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,26,0,0">
            <TextBlock Text="Jobs" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Jobs}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.68" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Progress}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open" Tag="{Binding ResultPath}" Click="OpenResult_Click" Padding="8,3" Margin="3,0" />
                                    <Button Content="Folder" Tag="{Binding ResultPath}" Click="ShowResultFolder_Click" Padding="8,3" Margin="3,0" />
                                    <Button Content="Copy path" Tag="{Binding ResultPath}" Click="CopyResultPath_Click" Padding="8,3" Margin="3,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
